{
  "harness-ide-session-bootstrap": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node scripts/hooks/session-start.mjs",
        "timeout": 10
      }
    ]
  },
  "harness-ide-snapshot-guard": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "node scripts/hooks/pre-invocation.mjs",
        "timeout": 10
      }
    ]
  },
  "harness-ide-swarm-telemetry-and-rag-sync": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/post-tool-use.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
